[Unit]
Description=Vibearr isolated task executor
After=network.target

[Service]
Type=simple
WorkingDirectory=@RELEASE@
EnvironmentFile=@RUNTIME@/service.env
ExecStart=@PYTHON@ -m vibearr_executor.server --state @RUNTIME@/executor --profiles @RUNTIME@/executor/profiles.json --token-file @RUNTIME@/executor.token --bind 127.0.0.1 --port @PORT@
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077

[Install]
WantedBy=default.target
