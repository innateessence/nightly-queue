COMPOSE_PROJECT_NAME=vibearr
VIBEARR_API_TOKEN=replace-with-a-random-token
VIBEARR_POSTGRES_PASSWORD=replace-with-a-random-password
# Fresh installations opt into new names. Keep old DB/user/volume settings on upgrade.
VIBEARR_POSTGRES_DB=vibearr
VIBEARR_POSTGRES_USER=vibearr
VIBEARR_DATA_PROJECT=vibearr
# Generate once; see README. Back up separately from PostgreSQL.
VIBEARR_CREDENTIAL_KEY=

# Separate identity provisioned with manage.py provision_runner.
VIBEARR_RUNNER_API_TOKEN=
# Existing installations retain /var/lib/coding-runner; do not relocate active state.
VIBEARR_RUNNER_STATE_DIR=/var/lib/vibearr
