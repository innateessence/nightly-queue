COMPOSE_PROJECT_NAME=vibearr
# Empty secrets are generated once for fresh volumes. On upgrade, supply originals.
VIBEARR_API_TOKEN=
VIBEARR_POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
# Fresh installations opt into new names. Keep old DB/user/volume settings on upgrade.
VIBEARR_POSTGRES_DB=vibearr
VIBEARR_POSTGRES_USER=vibearr
VIBEARR_DATA_PROJECT=vibearr
# Keep the original encryption key on upgrade. Back up with the database.
VIBEARR_CREDENTIAL_KEY=

# Docker runner identity/token are provisioned in a private volume; see Docker operations.
VIBEARR_BIND=127.0.0.1
PORT=7777
VIBEARR_RUNNER_NAME=docker-runner
# run.sh obtains the actual built runner image ID using operator Docker inspection.
VIBEARR_RUNNER_IMAGE_ID=
# Configure external Ollama endpoint/model in the UI; no Ollama service ships here.
